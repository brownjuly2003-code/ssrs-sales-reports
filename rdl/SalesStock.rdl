      </Page>
    </ReportSection>
  </ReportSections>
  <ReportParameters>
    <ReportParameter Name="StartDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=DateSerial(2026, 1, 1)</Value>
        </Values>
      </DefaultValue>
      <Prompt>Период с</Prompt>
    </ReportParameter>
    <ReportParameter Name="EndDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=DateSerial(2026, 1, 31)</Value>
        </Values>
      </DefaultValue>
      <Prompt>Период по</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>SnapshotDates</DataSetName>
          <ValueField>Day</ValueField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="RegionIds">
      <DataType>Integer</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>Regions</DataSetName>
          <ValueField>RegionId</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>Регионы</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>Regions</DataSetName>
          <ValueField>RegionId</ValueField>
          <LabelField>RegionName</LabelField>
        </DataSetReference>
      </ValidValues>
      <MultiValue>true</MultiValue>
    </ReportParameter>
    <ReportParameter Name="StoreIds">
      <DataType>Integer</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>Stores</DataSetName>
          <ValueField>StoreId</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>Магазины</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>Stores</DataSetName>
          <ValueField>StoreId</ValueField>
          <LabelField>StoreName</LabelField>
        </DataSetReference>
      </ValidValues>
      <MultiValue>true</MultiValue>
    </ReportParameter>
    <ReportParameter Name="CategoryIds">
      <DataType>Integer</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>Categories</DataSetName>
          <ValueField>CategoryId</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>Категории</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>Categories</DataSetName>
          <ValueField>CategoryId</ValueField>
          <LabelField>CategoryName</LabelField>
        </DataSetReference>
      </ValidValues>
      <MultiValue>true</MultiValue>
    </ReportParameter>
  </ReportParameters>
  <Language>ru-RU</Language>
</Report>
