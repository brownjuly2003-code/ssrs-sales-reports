                <TablixMember>
                </TablixMember>
                <TablixMember>
                </TablixMember>
                <TablixMember>
                </TablixMember>
              </TablixMembers>
            </TablixColumnHierarchy>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember>
                  <KeepWithGroup>After</KeepWithGroup>
                  <RepeatOnNewPage>true</RepeatOnNewPage>
                </TablixMember>
                <TablixMember>
                  <Group Name="ByRegion">
                    <GroupExpressions>
                      <GroupExpression>=Fields!RegionId.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Fields!RegionId.Value</Value>
                    </SortExpression>
                  </SortExpressions>
                  <TablixMembers>
                    <TablixMember>
                    </TablixMember>
                    <TablixMember>
                      <Group Name="ByStore">
                        <GroupExpressions>
                          <GroupExpression>=Fields!StoreId.Value</GroupExpression>
                        </GroupExpressions>
                      </Group>
                      <SortExpressions>
                        <SortExpression>
                          <Value>=Fields!StoreId.Value</Value>
                        </SortExpression>
                      </SortExpressions>
                      <TablixMembers>
                        <TablixMember>
                        </TablixMember>
                        <TablixMember>
                          <Group Name="ByCategory">
                            <GroupExpressions>
                              <GroupExpression>=Fields!CategoryId.Value</GroupExpression>
                            </GroupExpressions>
                          </Group>
                          <SortExpressions>
                            <SortExpression>
                              <Value>=Fields!CategoryId.Value</Value>
                            </SortExpression>
                          </SortExpressions>
                          <TablixMembers>
                            <TablixMember>
                            </TablixMember>
                            <TablixMember>
                              <Group Name="ByProduct">
                                <GroupExpressions>
                                  <GroupExpression>=Fields!ProductId.Value</GroupExpression>
                                </GroupExpressions>
                              </Group>
                              <SortExpressions>
                                <SortExpression>
                                  <Value>=Fields!ProductId.Value</Value>
                                </SortExpression>
                              </SortExpressions>
                              <Visibility>
                                <Hidden>true</Hidden>
                                <ToggleItem>LabelCategory</ToggleItem>
                              </Visibility>
                            </TablixMember>
                          </TablixMembers>
                          <Visibility>
                            <Hidden>true</Hidden>
                            <ToggleItem>LabelStore</ToggleItem>
                          </Visibility>
                        </TablixMember>
                      </TablixMembers>
                      <Visibility>
                        <Hidden>true</Hidden>
                        <ToggleItem>LabelRegion</ToggleItem>
                      </Visibility>
                    </TablixMember>
                  </TablixMembers>
                </TablixMember>
                <TablixMember>
                  <KeepWithGroup>Before</KeepWithGroup>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>
            <DataSetName>ReportRows</DataSetName>
            <NoRowsMessage>Нет строк для выбранных параметров: проверьте, что на дату окончания есть снимок остатков.</NoRowsMessage>
          </Tablix>
