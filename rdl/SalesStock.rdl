<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <DataSources>
    <DataSource Name="Retail">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=RetailLab</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Regions">
      <Query>
        <DataSourceName>Retail</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>dbo.Regions</CommandText>
      </Query>
      <Fields>
        <Field Name="RegionId">
          <DataField>RegionId</DataField>
        </Field>
        <Field Name="RegionName">
          <DataField>RegionName</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Stores">
      <Query>
        <DataSourceName>Retail</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@RegionIds">
            <Value>=Join(Parameters!RegionIds.Value, ",")</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>dbo.Stores</CommandText>
      </Query>
      <Fields>
        <Field Name="StoreId">
          <DataField>StoreId</DataField>
        </Field>
        <Field Name="StoreName">
          <DataField>StoreName</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Categories">
      <Query>
        <DataSourceName>Retail</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>dbo.Categories</CommandText>
      </Query>
      <Fields>
        <Field Name="CategoryId">
          <DataField>CategoryId</DataField>
        </Field>
        <Field Name="CategoryName">
          <DataField>CategoryName</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="SnapshotDates">
      <Query>
        <DataSourceName>Retail</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>dbo.SnapshotDates</CommandText>
      </Query>
      <Fields>
        <Field Name="Day">
          <DataField>Day</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ReportRows">
      <Query>
        <DataSourceName>Retail</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@RegionIds">
            <Value>=Join(Parameters!RegionIds.Value, ",")</Value>
          </QueryParameter>
          <QueryParameter Name="@StoreIds">
            <Value>=Join(Parameters!StoreIds.Value, ",")</Value>
          </QueryParameter>
          <QueryParameter Name="@CategoryIds">
            <Value>=Join(Parameters!CategoryIds.Value, ",")</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>dbo.ReportRows</CommandText>
      </Query>
      <Fields>
        <Field Name="RegionId">
          <DataField>RegionId</DataField>
        </Field>
        <Field Name="RegionName">
          <DataField>RegionName</DataField>
        </Field>
        <Field Name="StoreId">
          <DataField>StoreId</DataField>
        </Field>
        <Field Name="StoreName">
          <DataField>StoreName</DataField>
        </Field>
        <Field Name="CategoryId">
          <DataField>CategoryId</DataField>
        </Field>
        <Field Name="CategoryName">
          <DataField>CategoryName</DataField>
        </Field>
        <Field Name="ProductId">
          <DataField>ProductId</DataField>
        </Field>
        <Field Name="ProductName">
          <DataField>ProductName</DataField>
        </Field>
        <Field Name="Units">
          <DataField>Units</DataField>
        </Field>
        <Field Name="RevenueCents">
          <DataField>RevenueCents</DataField>
        </Field>
        <Field Name="OnHand">
          <DataField>OnHand</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Tablix Name="SalesAndStock">
